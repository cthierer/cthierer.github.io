{
	"name": "cthierer.github.io",
	"description": "My personal profile and resume site.",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"build": "tsx src/build/build.tsx",
		"build:resume": "tsx src/build/build.tsx --resume",
		"build:application": "tsx src/build/build.tsx --application",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm test",
		"clean": "rm -rf dist",
		"dev": "npm run build && concurrently -k -n build,serve -c yellow,cyan \"npm run watch\" \"npm run serve\"",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"prepare": "husky",
		"precommit": "lint-staged",
		"serve": "serve dist -l 3000",
		"test": "node --import tsx --test src/**/*.test.ts",
		"typecheck": "tsc --noEmit",
		"watch": "chokidar \"src/**/*\" \"content/**/*\" \"public/**/*\" config.yaml -c \"npm run build\""
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown",
		"*.{js,mjs,cjs,ts,tsx}": "eslint --fix"
	},
	"dependencies": {
		"@picocss/pico": "^2.1.1",
		"entities": "^8.0.0",
		"lucide-react": "^1.24.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"browserslist": "^4.28.7",
		"chokidar-cli": "^3.0.0",
		"concurrently": "^10.0.4",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.7.0",
		"gray-matter": "^4.0.3",
		"husky": "^9.1.7",
		"lightningcss": "^1.33.0",
		"lint-staged": "^17.0.8",
		"marked": "^18.0.6",
		"prettier": "^3.9.4",
		"serve": "^14.2.6",
		"tsx": "^4.23.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true
	}
}
