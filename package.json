{
	"name": "cthierer.github.io",
	"description": "My personal profile and resume site.",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"build": "npm run clean && npm run build:html && npm run build:css && npm run build:public && npm run build:pdf",
		"build:html": "tsx src/build/build.tsx",
		"build:css": "lightningcss --minify --bundle --targets \">= 0.25%\" src/styles/main.css -o dist/assets/main.css",
		"build:pdf": "weasyprint --media-type print --pdf-tags --pdf-variant pdf/ua-1 dist/resume.html dist/resume.pdf",
		"build:public": "cp -r public/* dist",
		"check": "npm run typecheck && npm run lint && npm run format:check",
		"clean": "rm -rf dist",
		"dev": "npm run build && concurrently -k -n build,serve -c yellow,cyan \"npm run watch\" \"npm run serve\"",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"prepare": "husky",
		"precommit": "lint-staged",
		"serve": "serve dist -l 3000",
		"typecheck": "tsc --noEmit",
		"watch": "chokidar \"src/**/*\" \"content/**/*\" \"public/**/*\" config.yaml -c \"npm run build\""
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown",
		"*.{js,mjs,cjs,ts,tsx}": "eslint --fix"
	},
	"dependencies": {
		"@picocss/pico": "^2.1.1",
		"lucide-react": "^1.24.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"chokidar-cli": "^3.0.0",
		"concurrently": "^10.0.4",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.7.0",
		"gray-matter": "^4.0.3",
		"husky": "^9.1.7",
		"lightningcss-cli": "^1.32.0",
		"lint-staged": "^17.0.8",
		"marked": "^18.0.6",
		"prettier": "^3.9.4",
		"serve": "^14.2.6",
		"tsx": "^4.23.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"lightningcss-cli@1.32.0": true
	}
}
